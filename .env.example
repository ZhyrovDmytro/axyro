# Server-only. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=

# The AI planner is opt-in; deterministic planning remains the fallback.
AI_PLANNER_ENABLED=false
OPENAI_PLANNER_MODEL=gpt-4o-mini

# Supabase project (server only). Apply supabase/migrations in order first.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy JWT keys remain supported when the corresponding modern key is unset.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Canonical HTTPS production origin (local example: http://localhost:3100).
APP_URL=http://localhost:3100

# Stripe server-side subscriptions; use test keys/prices locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
# Optional USD regional prices; the original price IDs above remain EUR.
STRIPE_USD_MONTHLY_PRICE_ID=
STRIPE_USD_YEARLY_PRICE_ID=

# Optional public support address override. Defaults to support@axyro.app.
AXYRO_SUPPORT_EMAIL=
# Publishable legal identity for the individual or entity operating Axyro.
AXYRO_OPERATOR_NAME=
AXYRO_OPERATOR_ADDRESS=
AXYRO_OPERATOR_REGISTRATION=
AXYRO_OPERATOR_PHONE=

# Server-only Resend API key and verified sender for contractual email.
AXYRO_BILLING_EMAIL_API_KEY=
AXYRO_BILLING_FROM_EMAIL=
# Enable only after the launch tracker confirms live checkout configuration.
AXYRO_LIVE_CHECKOUT_ENABLED=false

# Optional workout event counts. Keep off until hosting log retention is documented.
NEXT_PUBLIC_AXYRO_ANALYTICS=false
