# Server-only. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=

# The AI planner is opt-in; deterministic planning remains the fallback.
AI_PLANNER_ENABLED=false
OPENAI_PLANNER_MODEL=gpt-4o-mini

# Supabase project (server only). Apply supabase/migrations in order first.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Canonical HTTPS production origin (local example: http://localhost:3100).
APP_URL=http://localhost:3100

# Stripe server-side subscriptions; use test keys/prices locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
